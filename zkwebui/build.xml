<?xml version="1.0" encoding="UTF-8"?>
<!-- ======================================================== -->
<!-- Zk Ajax UI (Web UI)                                      -->
<!-- ======================================================== -->

<project name="ZkWebUI"
         default="war"
         basedir="."
         xmlns:if="ant:if"
         xmlns:unless="ant:unless">

  <description>
	    This buildfile stages the frozen legacy Zk WebUI client.

	    Phase 5d migrated WEB-INF/src to ZK CE 10.3.0.1-jakarta, so this build
	    file no longer compiles it: the migrated source cannot be compiled
	    against the ZK 3.6 jars in WEB-INF/lib, and compiling it against ZK CE
	    would silently change the shipped legacy artifact that the Phase 5b
	    oracle is pinned to. Gradle owns the migrated compile
	    (:zkwebui:compileModernUiJava) and the migrated tests
	    (:zkwebui:modernUiTest); this build file only materializes and stages
	    the frozen legacy webui.war.
  	</description>
  <!-- set global properties for this build -->
  <import file="../utils_dev/properties.xml" />
  <import file="../utils_dev/phase5d-frozen-zk.xml" />

  <!--<property environment="env"/>-->
  <property name="src.dir" value="${basedir}/WEB-INF/src" />
  <property name="classes.dir" value="${basedir}/WEB-INF/classes" />
  <property name="dist.dir" value="${basedir}/dist" />
  <property name="WEBINF.dir" value="${basedir}/WEB-INF" />
  <property name="Adempiere.dir" value="${basedir}/../lib">
  </property>

  <property name="war.name" value="webui" />

  <target name="clean" description="delete class and distribution directories">
    <!-- WEB-INF/classes/org only ever held the ZK 3.6 compile output that
         Phase 5d retired, so removing it keeps a stale legacy compile from
         leaking onto any downstream classpath. -->
    <delete dir="${classes.dir}/org" />
    <delete dir="${dist.dir}" />
  </target>

  <target name="war" depends="clean, phase5d.materialize-frozen-zk"
          description="Stages the frozen legacy webui.war built from the Phase 5b source commit">
    <echo message="=========== Stage frozen Zk Ajax UI ===========" />
    <mkdir dir="${dist.dir}" />
    <!-- dist/*.war stays populated because the packaged ZK modules resolve it
         on their Ant compile classpath. -->
    <copy file="${phase5d.frozen.war}"
          tofile="${dist.dir}/${war.name}.war"
          overwrite="true" />
    <copy file="${phase5d.frozen.war}"
          tofile="${Adempiere.dir}/${war.name}.war"
          overwrite="true" />
  </target>

</project>
