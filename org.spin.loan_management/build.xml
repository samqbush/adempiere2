<project name="LoanManagement" default="zkdist" basedir=".">
    <description>
        Building LoanManagement.jar
        by
        Yamel Senih 
        http://www.erpya.com
    </description>
  <!-- set global properties for this build -->
  <import file="../utils_dev/properties.xml"/>
  <import file="../utils_dev/phase5d-frozen-zk.xml"/>
  <property name="src" location="src/main/java/base"/>
  <property name="build" location="build"/>
  <property name="dist"  location="dist"/>
  <property name="base" location="../base/src"/>
  <property name="FinanceManagement" location="../org.spin.Finance_management/src"/>
   <property name="controller" location="${basedir}/src/main/java/ui/swing"/>
  <property name="zksrc" value="${basedir}/src/main/java/ui/zk"/>
  <property name="zkclasses" value="${basedir}/build/zkwebui/WEB-INF/classes"/>

  <path id="lib.class.path">
     <fileset dir="../lib">
        <include name="*.jar"/>
     </fileset>
    <fileset dir="../packages">
       <include name="*.jar"/>
    </fileset>
  </path>
  <path id="compile.classpath">
    <pathelement location="${basedir}/build"/>
    <pathelement location="../zkwebui/WEB-INF/classes"/>
    <fileset dir="../lib">
        <include name="*.jar"/>
    </fileset>
    <fileset dir="../packages">
        <include name="*.jar"/>
    </fileset>
    <fileset dir="../zkwebui/WEB-INF/lib">
        <include name="*.jar"/>
    </fileset>
  </path>

  <target name="init" depends="clean">
    <echo message="Trunk location: .."/>
    <!-- Create the time stamp -->
    <tstamp/>
    <!-- Create the build directory structure used by compile -->
    <mkdir dir="${build}"/>
    <!-- Create the classes directory structure used by compile -->
    <mkdir dir="${zkclasses}"/>
  </target>

  <target name="compile" depends="init"
        description="compile the source " >
    <!-- Compile the java code from ${src} into ${build} -->
    <javac encoding="UTF-8" srcdir="${src}" sourcepath="${base}:${FinanceManagement}:${controller}" destdir="${build}" includeantruntime="false">
      <classpath refid="lib.class.path"/>
    </javac>

  </target>

  <target name="dist" depends="compile"
        description="generate the distribution" >
    <!-- Create the distribution directory -->
    <mkdir dir="${dist}/lib"/>

    <!-- Put everything in ${build} into the MyProject-${DSTAMP}.jar file -->
    <jar jarfile="${dist}/lib/LoanManagement.jar" basedir="${build}"/>

    <!-- Create target Libero deployment -->
    <mkdir dir="${env.ADEMPIERE_HOME}/packages/LoanManagement/lib"/>

    <!-- Transfer liberoWM.jar -->
    <copy file="${dist}/lib/LoanManagement.jar" todir="${env.ADEMPIERE_HOME}/packages/LoanManagement/lib"/>
    <copy file="${dist}/lib/LoanManagement.jar" todir="../packages/"/>

  </target>

    <target name="zkcompile" depends="dist, phase5d.materialize-frozen-zk"
            description="stage the frozen legacy ZK package jar" >
        <!-- Phase 5d: src/main/java/ui/zk now targets ZK CE 10.3.0.1-jakarta and is
             compiled by Gradle (:org.spin.loan_management:compileZkUiJava). Compiling it here
             against the ZK 3.6 jars in ../zkwebui/WEB-INF/lib is impossible, and
             compiling it against ZK CE would change the shipped legacy artifact the
             Phase 5b oracle is pinned to, so the frozen jar built from the Phase 5b
             source commit is staged instead. -->
        <echo message="Phase 5d: staging the frozen LoanManagementZk.jar"/>
    </target>

    <target name="zkdist" depends="zkcompile"
            description="generate the distribution" >
        <!-- Create the distribution directory -->
        <mkdir dir="${dist}/lib"/>
        <!-- Phase 5d: stage the frozen legacy ZK package jar instead of rebuilding it -->
        <copy file="${phase5d.frozen.zkpackages}/LoanManagementZk.jar" tofile="${dist}/lib/LoanManagementZk.jar" overwrite="true"/>

        <!-- Create target Liberozk deployment -->
        <mkdir dir="${env.ADEMPIERE_HOME}/zkpackages/LoanManagement/lib"/>

        <!-- Transfer liberozkWM.jar -->
        <copy file="${dist}/lib/LoanManagementZk.jar" todir="${env.ADEMPIERE_HOME}/zkpackages/LoanManagement/lib"/>
        <copy file="${dist}/lib/LoanManagementZk.jar" todir="../zkpackages/"/>
    </target>


  <target name="clean"
        description="clean up" >
    <!-- Delete the ${build} and ${dist} directory trees -->
    <delete dir="${build}"/>
    <delete dir="${dist}"/>
    <delete dir="${zkclasses}"/>
  </target>
</project>
