<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- START SNIPPET: webxml -->
<!DOCTYPE web-app
    PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
    "http://java.sun.com/dtd/web-app_2_3.dtd">
    
<web-app>

  <servlet>
    <servlet-name>SoapCompatibilityRouter</servlet-name>
    <servlet-class>
        org.adempiere.webservice.router.SoapCompatibilityRouter
    </servlet-class>
    <init-param>
      <param-name>modernBaseUrl</param-name>
      <param-value>http://127.0.0.1:8890/ADInterface/services</param-value>
    </init-param>
    <init-param>
      <param-name>maxRequestBytes</param-name>
      <param-value>1048576</param-value>
    </init-param>
    <init-param>
      <param-name>connectTimeoutMillis</param-name>
      <param-value>5000</param-value>
    </init-param>
    <init-param>
      <param-name>readTimeoutMillis</param-name>
      <param-value>30000</param-value>
    </init-param>
  </servlet>

  <servlet-mapping>
    <servlet-name>SoapCompatibilityRouter</servlet-name>
    <url-pattern>/services/*</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>SoapCompatibilityRouter</servlet-name>
    <url-pattern>/servlet/XFireServlet/*</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>15</session-timeout>
  </session-config>

  <resource-ref>
    <description>Adempiere Connection Pool</description>
    <res-ref-name>java/AdempiereDS</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

  <resource-ref>
    <description>Adempiere Short Running Connection Pool</description>
    <res-ref-name>java/AdempiereSRDS</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

</web-app>
<!-- END SNIPPET: webxml -->